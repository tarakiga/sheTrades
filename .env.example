# Shared runtime variables (no secrets)
NODE_ENV=development

# Backend
PORT=8080
# Postgres connection string. Required — the backend cannot boot without it.
# The value below matches the local `db` service in docker-compose.local.yml
# (host port 5555). In staging/production this is injected by the deployment
# pipeline / Secret Manager, never committed.
POSTGRES_URL=postgres://postgres:password@localhost:5555/shetrades
# Secret used to sign/verify admin session JWTs. Use a long random string
# (e.g. `openssl rand -base64 48`). NEVER commit the real value — set it in
# .env.local locally and via the deployment pipeline / Secret Manager in prod.
ADMIN_CONFIG_JWT_SECRET=replace-with-a-long-random-secret
ADMIN_AUTH_SESSION_TTL_SECONDS=43200
# Seed admin created on first boot when the admin_accounts table is empty.
ADMIN_AUTH_BOOTSTRAP_EMAIL=replace-with-admin-email
ADMIN_AUTH_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
ADMIN_AUTH_BOOTSTRAP_FULL_NAME=SheTrades Admin
ADMIN_AUTH_BOOTSTRAP_ROLE=admin
ADMIN_AUTH_BOOTSTRAP_STATUS=active
ADMIN_AUTH_BOOTSTRAP_AVATAR_URL=
# Token guarding the donor/report export API (x-admin-token). Required to
# enable that surface — when unset the export endpoints are disabled (fail closed).
ADMIN_REPORTS_API_TOKEN=replace-with-reports-api-token
# Payout dispatch policy (optional; defaults shown). Tune throughput/retries
# without a code deploy.
# PAYOUTS_BATCH_LIMIT=50
# PAYOUTS_RETRY_CEILING=3
# PAYOUTS_BASE_DELAY_MS=300000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
BACKEND_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Origin used to build the sign-in link in admin invite emails (origin only, no
# path). Falls back to the first CORS origin above when unset, so keep the
# console's host first there.
# ADMIN_DASHBOARD_URL=https://admin.shetrades.digital

# Dashboard: hostnames that serve the OPERATOR CONSOLE. Every other hostname
# serves only the public documents (/privacy, /c/...) and 404s the rest - the
# bot mails the policy URL to every participant, so the console must not sit
# beside it. Comma-separated; bare hostnames or full origins both work.
#
# localhost and *.vercel.app are always treated as the console, so an unset or
# wrong value here cannot lock the team out. Read by Next.js middleware at BUILD
# time, so changing it in Vercel needs a redeploy, not just a save.
# ADMIN_HOSTS=admin.shetrades.digital

# Dashboard: serve /previews (the component workshop). Defaults OFF whenever
# NODE_ENV is production, which on Vercel is every deployment. The workshop
# server-renders every admin workspace inline, so its markup reaches an
# unauthenticated caller through the RSC payload even behind a client-side auth
# gate - not shipping the route is the only complete answer. Set to true only to
# put it up deliberately for a design review. Build-time, like ADMIN_HOSTS.
# ENABLE_COMPONENT_PREVIEWS=true

# Optional: webhook
WHATSAPP_VERIFY_TOKEN=replace-with-verify-token
# Meta app secret used to verify the inbound X-Hub-Signature-256 HMAC on
# webhooks. Normally set via the WhatsApp integration config in the admin UI;
# this env var is the fallback. When neither is set, signature verification is
# SKIPPED (logged as a warning) — set it to enforce.
# WHATSAPP_APP_SECRET=replace-with-meta-app-secret

# Reward defaults used when no reward rule is published (amount in NGN).
# REWARD_DEFAULT_AMOUNT=500
# REWARD_DEFAULT_CHANNEL=airtime

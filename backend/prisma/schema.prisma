generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid())
  phone        String         @unique
  name         String?
  language     String?
  location     String?
  status             String         @default("Active")
  flaggedForFollowUp Boolean        @default(false)
  followUpNote       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  session      UserSession?
  progress     UserProgress[]
  quizAttempts QuizAttempt[]
  rewards      Reward[]

  @@map("users")
}

model UserSession {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  state              String
  selectedModuleId   String?
  currentLessonKey   String?
  completedLessons   String[]
  awaitingQuizAnswer Boolean  @default(false)
  currentQuizIndex   Int      @default(0)
  namePrompted       Boolean  @default(false)
  lastUpdatedAt      DateTime @default(now())

  @@map("user_sessions")
}

model UserProgress {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  module               String
  completionPercentage Float    @default(0.0)
  updatedAt            DateTime @updatedAt

  @@unique([userId, module])
  @@map("user_progress")
}

model QuizAttempt {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  lessonKey     String
  passed        Boolean  @default(false)
  attemptCount  Int      @default(1)
  lastAttemptAt DateTime @default(now())

  @@unique([userId, lessonKey])
  @@map("quiz_attempts")
}

model AdminAccount {
  id           String    @id @default(uuid())
  email        String    @unique
  fullName     String
  passwordHash String
  role         String    @default("admin")
  status       String    @default("active")
  avatarUrl    String    @default("")
  lastLoginAt  DateTime?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_accounts")
}

model Reward {
  id                String     @id @default(uuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id])
  module            String
  amount            Float
  channel           String
  status            String     @default("Pending")
  issuedAt          DateTime?
  learnerPhone      String     @default("")
  providerTxnId     String?
  failureReason     String?
  retryCount        Int        @default(0)
  nextAttemptAt     DateTime?
  attemptInProgress Boolean    @default(false)
  noteFromActor     String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([userId, module])
  @@map("rewards")
}

/// GAP-D1: translation requests were held in an in-memory Map, so every
/// request was lost whenever the Cloud Run instance scaled to zero (and never
/// shared across replicas). Persisted here so the /content translation queue
/// survives restarts.
model TranslationRequest {
  id                   String    @id @default(uuid())
  contentDocumentId    String
  contentKey           String
  contentTitle         String
  sourceLanguage       String
  method               String
  targetLanguage       String
  priority             String
  note                 String    @default("")
  status               String
  integrationState     String?
  integrationJobId     String?
  completionNote       String?
  completedAt          DateTime?
  completedBy          String?
  reviewDraftVersionId String?
  requestedBy          String
  requestedAt          DateTime  @default(now())

  @@index([requestedAt])
  @@map("translation_requests")
}

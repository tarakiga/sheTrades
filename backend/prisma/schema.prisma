generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid())
  phone        String         @unique
  name         String?
  language     String?
  location     String?
  status             String         @default("Active")
  flaggedForFollowUp Boolean        @default(false)
  followUpNote       String?
  /// When the follow-up flag was last raised. Distinct from updatedAt, which
  /// changes on ANY write and would reorder the "most recent help requests"
  /// list whenever an unrelated field changed.
  flaggedAt          DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  session      UserSession?
  progress     UserProgress[]
  quizAttempts QuizAttempt[]
  rewards      Reward[]

  @@map("users")
}

model UserSession {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  state              String
  selectedModuleId   String?
  currentLessonKey   String?
  completedLessons   String[]
  awaitingQuizAnswer Boolean  @default(false)
  currentQuizIndex   Int      @default(0)
  // R3-F8: consecutive wrong attempts on the CURRENT question; drives the
  // "hint on second try" retry copy. Reset when the question advances.
  quizRetryCount     Int      @default(0)
  namePrompted       Boolean  @default(false)
  lastUpdatedAt      DateTime @default(now())

  @@map("user_sessions")
}

model UserProgress {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  module               String
  completionPercentage Float    @default(0.0)
  updatedAt            DateTime @updatedAt

  @@unique([userId, module])
  @@map("user_progress")
}

model QuizAttempt {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  lessonKey     String
  passed        Boolean  @default(false)
  attemptCount  Int      @default(1)
  lastAttemptAt DateTime @default(now())

  @@unique([userId, lessonKey])
  @@map("quiz_attempts")
}

model AdminAccount {
  id           String    @id @default(uuid())
  email        String    @unique
  fullName     String
  passwordHash String
  role         String    @default("admin")
  status       String    @default("active")
  avatarUrl    String    @default("")
  lastLoginAt  DateTime?
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_accounts")
}

model Reward {
  id                String     @id @default(uuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id])
  module            String
  amount            Float
  channel           String
  status            String     @default("Pending")
  issuedAt          DateTime?
  learnerPhone      String     @default("")
  providerTxnId     String?
  failureReason     String?
  retryCount        Int        @default(0)
  nextAttemptAt     DateTime?
  attemptInProgress Boolean    @default(false)
  noteFromActor     String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([userId, module])
  @@map("rewards")
}

/// GAP-D1: translation requests were held in an in-memory Map, so every
/// request was lost whenever the Cloud Run instance scaled to zero (and never
/// shared across replicas). Persisted here so the /content translation queue
/// survives restarts.
model TranslationRequest {
  id                   String    @id @default(uuid())
  contentDocumentId    String
  contentKey           String
  contentTitle         String
  sourceLanguage       String
  method               String
  targetLanguage       String
  priority             String
  note                 String    @default("")
  status               String
  integrationState     String?
  integrationJobId     String?
  completionNote       String?
  completedAt          DateTime?
  completedBy          String?
  reviewDraftVersionId String?
  requestedBy          String
  requestedAt          DateTime  @default(now())

  @@index([requestedAt])
  @@map("translation_requests")
}

model TranslationDraft {
  id                String   @id @default(uuid())
  contentDocumentId String
  contentKey        String
  targetLanguage    String   // "pcm" | "ig"
  // Translated strings, shape: { title?, body?, quiz: [{ question?, options: (string|null)[] }] }
  // A null option means that option failed translation and must stay English.
  payload           Json
  // Per-string machine outcome summary for the reviewer, e.g. counts of
  // translated / failed / over-budget. Recomputed on each run.
  runSummary        Json?
  status            String   @default("machine_draft") // machine_draft | in_review | approved | promoted
  assignee          String?
  // Hash of the English source strings at translation time. If the live English
  // no longer hashes to this, the draft is stale.
  sourceHash        String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  promotedAt        DateTime?

  @@unique([contentDocumentId, targetLanguage])
  @@map("translation_drafts")
}

model OutboundMessage {
  id        String   @id @default(uuid())
  phone     String
  kind      String   // "text" | "template"
  // The text body for a free-text send, or the template name for a template send.
  body      String
  status    String   // "sent" | "failed"
  // Provider message id on success; failure reason otherwise.
  detail    String?
  sentBy    String
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@map("outbound_messages")
}

/// CS-7: a standing instruction to generate a report on a cadence and email it.
/// Cadence semantics (weekly/monthly/…) come from the reports.cadence_options
/// config option set; this row stores the chosen option's value plus a snapshot
/// of its metadata so an unattended run still works if the option set changes
/// underneath it. recipients is [{ email, label? }].
model ReportSchedule {
  id              String    @id @default(uuid())
  presetId        String
  /// Report type resolved from the preset's config metadata at save time.
  /// The worker re-resolves from live config first and falls back to this,
  /// so a schedule survives a preset being edited or unpublished.
  reportType      String
  cadenceKey      String
  cadenceSnapshot Json
  recipients      Json
  enabled         Boolean   @default(true)
  lastRunAt       DateTime?
  lastRunStatus   String?
  lastRunDetail   String?
  nextRunAt       DateTime
  createdBy       String
  updatedBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enabled, nextRunAt])
  @@map("report_schedules")
}

/// Login throttling state. Persisted (not in-memory) for the same reason as
/// AdminSession: Cloud Run runs several replicas, and an in-memory counter
/// would let an attacker spread guesses across instances and reset on every
/// scale-to-zero. One row per (scope, key) — scope is "email" today, leaving
/// room for "ip" once the Cloud Run X-Forwarded-For shape is confirmed.
model AuthThrottle {
  id             String    @id @default(uuid())
  scope          String
  key            String
  /// Failures inside the CURRENT window; reset when the window lapses.
  failures       Int       @default(0)
  firstFailureAt DateTime?
  /// Set when the threshold trips; requests are refused until it passes.
  lockedUntil    DateTime?
  /// How many times this key has been locked out — drives progressive backoff
  /// so repeat offenders wait longer while a fat-fingered admin waits minutes.
  lockoutCount   Int       @default(0)
  updatedAt      DateTime  @updatedAt

  @@unique([scope, key])
  @@index([lockedUntil])
  @@map("auth_throttle")
}

/// GAP-D1: admin sessions were held in an in-memory Map, so a session minted on
/// one Cloud Run instance was invalid on another and every session was dropped
/// when the service scaled to zero — logging admins out unpredictably.
model AdminSession {
  id          String    @id @default(uuid())
  adminUserId String
  tokenId     String
  expiresAt   DateTime
  revokedAt   DateTime?
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@map("admin_sessions")
}

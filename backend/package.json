{
  "name": "@shetrades/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env.local src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "smoke:staging": "tsx src/smoke/staging-smoke.ts",
    "validate:reliability": "tsx src/validation/reliability-check.ts",
    "seed:admin-ui-copy": "tsx src/config-platform/seed-admin-ui-copy.ts",
    "seed:lessons": "tsx src/config-platform/seed-lessons.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.5.0",
    "express": "^5.1.0",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "supertest": "^7.2.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.8.1",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "tsx": "^4.20.6"
  }
}

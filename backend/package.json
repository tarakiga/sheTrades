{
  "name": "@shetrades/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env.local src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:ci": "tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "db:setup:test": "tsx src/scripts/setup-test-db.ts",
    "smoke:staging": "tsx src/smoke/staging-smoke.ts",
    "smoke:payouts": "tsx src/smoke/payouts-smoke.ts",
    "validate:reliability": "tsx src/validation/reliability-check.ts",
    "seed:admin-ui-copy": "tsx src/config-platform/seed-admin-ui-copy.ts",
    "seed:lessons": "tsx src/config-platform/seed-lessons.ts",
    "seed:state-options": "tsx src/config-platform/seed-state-options.ts",
    "seed:bot-prompts": "tsx src/config-platform/seed-bot-prompts.ts",
    "seed:frontend-options": "tsx src/config-platform/seed-frontend-options.ts",
    "seed:legal-privacy": "tsx src/config-platform/seed-legal-privacy.ts",
    "seed:branding": "tsx src/config-platform/seed-branding.ts",
    "ops:reset-learner-data": "tsx src/ops/reset-learner-data.ts",
    "db:migrate:baseline": "prisma migrate resolve --applied 000000000000_baseline",
    "db:migrate:deploy": "prisma migrate deploy",
    "seed:certificate-template": "tsx src/config-platform/seed-certificate-template.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "express": "^5.1.0",
    "nodemailer": "^8.0.7",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "supertest": "^7.2.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.8.1",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "prisma": "^7.8.0",
    "tsx": "^4.20.6"
  }
}
